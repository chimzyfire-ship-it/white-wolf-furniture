<section id="contact" class="contact-section"><div class="shell contact-grid"><div><p class="eyebrow">05 / Make it yours</p><h2>A beautiful space<br/>starts with <em>a conversation.</em></h2><p class="contact-intro">Tell us what you have in mind. We’ll help you find the right proportions, materials, and finish for your home.</p><div class="contact-details"><div><small>Call the workshop</small><a href="tel:+2347051008570">+234 705 100 8570</a><br/><a href="tel:+2347030214096">+234 703 021 4096</a></div><div><small>Write to us</small><a href="mailto:Whitewolffurniture@gmail.com">Whitewolffurniture@gmail.com</a></div><div><small>Visit us</small><p>No 2 Bress Ometa, New Ogorode,<br/>Sapele, Delta State, Nigeria</p></div></div></div><form id="contact-form"><input type="checkbox" name="botcheck" hidden tabindex="-1" aria-hidden="true"/><div><label for="contact-name">Your name</label><input id="contact-name" name="name" autocomplete="name" required placeholder="Full name"/></div><div><label for="contact-email">Email address</label><input id="contact-email" type="email" name="email" autocomplete="email" required placeholder="you@example.com"/></div><div><label for="contact-phone">Phone number <span>(optional)</span></label><input id="contact-phone" type="tel" name="phone" autocomplete="tel" placeholder="Your phone number"/></div><div><label for="contact-message">What would you like us to make?</label><textarea id="contact-message" name="message" rows="4" required placeholder="A piece, a room, an idea…"></textarea></div><button id="submit-btn" type="submit" class="button"><span id="btn-text">Send message</span><span aria-hidden="true">↗</span></button><div id="form-msg" class="hidden form-message" role="status" aria-live="polite"></div></form></div></section>
<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text');
  const formMsg = document.getElementById('form-msg');

  if (form && submitBtn && btnText && formMsg) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      submitBtn.disabled = true;
      btnText.textContent = 'Sending...';
      formMsg.classList.add('hidden');
      formMsg.classList.remove('bg-green-500/10', 'text-green-400', 'bg-red-500/10', 'text-red-400');
      
      const formData = new FormData(form);
      
      try {
        const response = await fetch('/api/send-email', {
          method: 'POST',
          body: formData,
        });
        
        const data = await response.json();
        
        formMsg.classList.remove('hidden');
        if (data.success) {
          formMsg.textContent = 'Message sent! We will reach out to you shortly.';
          formMsg.classList.add('bg-green-500/10', 'text-green-400');
          form.reset();
        } else {
          formMsg.textContent = data.message || 'Error sending message. Please try again.';
          formMsg.classList.add('bg-red-500/10', 'text-red-400');
        }
      } catch (error) {
        formMsg.classList.remove('hidden');
        formMsg.textContent = 'Network error. Please try again later.';
        formMsg.classList.add('bg-red-500/10', 'text-red-400');
      } finally {
        submitBtn.disabled = false;
        btnText.textContent = 'Send message';
      }
    });
  }
</script>
