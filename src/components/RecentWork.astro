---
import { recentWork } from '../data/recentWork';
const photos=recentWork.filter(i=>i.kind==='photo');
const videos=recentWork.filter(i=>i.kind==='video');
---
<section id="recent-work" class="section shell">
 <div class="section-heading"><div><p class="eyebrow">03 / The latest chapter</p><h2>Recently <em>done.</em></h2></div><a class="text-link" href="#contact">Imagine what’s next ↗</a></div>
 <div class="recent-grid">{photos.map((item,i)=><figure><a href={item.poster} target="_blank" rel="noopener" aria-label={`View full image: ${item.title}`}><img src={item.src} width="480" height="540" alt={item.title} loading="lazy" decoding="async"/><span class="image-open" aria-hidden="true">↗</span></a><figcaption><small>{item.category}</small><h3>{item.title}</h3></figcaption></figure>)}</div>
 <details class="project-films"><summary><span><small>A closer look</small>See our work in motion</span><span class="film-count">6 project films <span aria-hidden="true">+</span></span></summary><div class="film-grid">{videos.map(item=><figure><video controls playsinline preload="none" poster={item.poster} aria-label={item.title}><source src={item.src} type="video/mp4"/></video><figcaption><small>{item.category}</small><h3>{item.title}</h3></figcaption></figure>)}</div></details>
</section>
<script>
 document.querySelectorAll<HTMLVideoElement>('.project-films video').forEach(video=>{
  video.addEventListener('play',()=>{document.querySelectorAll<HTMLVideoElement>('video').forEach(other=>{if(other!==video)other.pause()})});
 });
 document.querySelector('.project-films')?.addEventListener('toggle',event=>{if(!(event.target as HTMLDetailsElement).open)document.querySelectorAll<HTMLVideoElement>('.project-films video').forEach(v=>v.pause())});
 document.addEventListener('visibilitychange',()=>{if(document.hidden)document.querySelectorAll<HTMLVideoElement>('video').forEach(v=>v.pause())});
</script>
