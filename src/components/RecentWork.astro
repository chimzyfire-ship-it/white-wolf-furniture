---
import { recentWork } from '../data/recentWork';
---

<section id="recent-work" class="recent-work-section py-20 sm:py-28 relative overflow-hidden">
  <div class="recent-work-glow" aria-hidden="true"></div>
  <div class="container mx-auto px-5 sm:px-8 relative z-10">
    <div class="recent-work-heading reveal">
      <div>
        <p class="recent-work-eyebrow"><span></span>Fresh from White Wolf<span></span></p>
        <h2>Recently <em>Done</em></h2>
        <p class="recent-work-intro">A closer look at the details, finishes, and spaces we’ve been shaping.</p>
      </div>
      <a class="recent-work-link" href="#gallery">Explore every category <span aria-hidden="true">↗</span></a>
    </div>

    <div class="recent-work-grid">
      {recentWork.map((item, index) => (
        <article class="recent-work-card reveal" style={`--card-index:${index}`}>
          <div class="recent-work-media">
            {item.kind === 'video' ? (
              <video controls muted playsinline preload="none" poster={item.poster} aria-label={`${item.title} video`}>
                <source src={item.src} type="video/mp4" />
                Your browser does not support video playback.
              </video>
            ) : (
              <img src={item.src} alt={item.title} loading="lazy" decoding="async" />
            )}
            <span class="recent-work-kind">{item.kind === 'video' ? 'Watch project' : 'Project'}</span>
          </div>
          <div class="recent-work-caption">
            <div>
              <p>{item.category}</p>
              <h3>{item.title}</h3>
            </div>
            <span class="recent-work-arrow" aria-hidden="true">↗</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .recent-work-section {
    background: linear-gradient(180deg, #071526 0%, #09192a 48%, #051020 100%);
    border-top: 1px solid rgba(160, 174, 192, .1);
    border-bottom: 1px solid rgba(160, 174, 192, .08);
  }
  .recent-work-glow {
    position: absolute;
    width: 620px;
    height: 620px;
    top: -280px;
    right: -180px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(160,174,192,.09), transparent 68%);
    pointer-events: none;
  }
  .recent-work-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    margin-bottom: 2.25rem;
  }
  .recent-work-eyebrow {
    display: flex;
    align-items: center;
    gap: .7rem;
    margin: 0 0 .7rem;
    color: #b7c3d1;
    font-size: .65rem;
    letter-spacing: .28em;
    text-transform: uppercase;
  }
  .recent-work-eyebrow span {
    width: 1.5rem;
    height: 1px;
    background: rgba(183,195,209,.45);
  }
  .recent-work-heading h2 {
    margin: 0;
    color: rgba(255,255,255,.94);
    font-size: clamp(2.35rem, 5vw, 4.4rem);
    font-weight: 700;
    letter-spacing: -.045em;
    line-height: 1;
  }
  .recent-work-heading h2 em {
    color: #b7c3d1;
    font-weight: 400;
  }
  .recent-work-intro {
    max-width: 34rem;
    margin: .9rem 0 0;
    color: rgba(226,232,240,.62);
    font-size: .9rem;
    line-height: 1.7;
  }
  .recent-work-link {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    padding: .8rem 0;
    color: #d2dae4;
    border-bottom: 1px solid rgba(183,195,209,.4);
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    transition: color .25s ease, border-color .25s ease;
  }
  .recent-work-link:hover { color: white; border-color: white; }
  .recent-work-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .recent-work-card {
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 1rem;
    background: linear-gradient(145deg, rgba(255,255,255,.055), rgba(255,255,255,.015));
    box-shadow: 0 16px 42px rgba(0,0,0,.2);
    transition: transform .35s ease, border-color .35s ease, box-shadow .35s ease;
    transition-delay: calc(var(--card-index, 0) * 35ms);
  }
  .recent-work-card:hover {
    transform: translateY(-5px);
    border-color: rgba(183,195,209,.34);
    box-shadow: 0 24px 55px rgba(0,0,0,.32);
  }
  .recent-work-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1.36;
    background: #0b1724;
  }
  .recent-work-media img,
  .recent-work-media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .7s cubic-bezier(.2,.75,.25,1);
  }
  .recent-work-card:hover .recent-work-media img { transform: scale(1.045); }
  .recent-work-media video { background: #080e17; }
  .recent-work-kind {
    position: absolute;
    top: .8rem;
    left: .8rem;
    padding: .45rem .65rem;
    border: 1px solid rgba(255,255,255,.2);
    border-radius: 999px;
    color: white;
    background: rgba(5,16,32,.62);
    backdrop-filter: blur(10px);
    font-size: .55rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    pointer-events: none;
  }
  .recent-work-caption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 5.5rem;
    padding: 1rem 1.1rem;
  }
  .recent-work-caption p {
    margin: 0 0 .35rem;
    color: #b7c3d1;
    font-size: .58rem;
    letter-spacing: .17em;
    text-transform: uppercase;
  }
  .recent-work-caption h3 {
    margin: 0;
    color: rgba(255,255,255,.92);
    font-size: 1rem;
    font-weight: 600;
  }
  .recent-work-arrow {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    flex: none;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 50%;
    color: #cbd5e1;
  }
  @media (max-width: 850px) {
    .recent-work-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .recent-work-section { padding-top: 4.5rem; padding-bottom: 4.5rem; }
    .recent-work-heading { display: block; margin-bottom: 1.5rem; }
    .recent-work-link { margin-top: 1rem; }
    .recent-work-grid { gap: .7rem; }
    .recent-work-card { border-radius: .75rem; }
    .recent-work-media { aspect-ratio: .92; }
    .recent-work-caption { min-height: 5rem; padding: .75rem; }
    .recent-work-caption h3 { font-size: .82rem; }
    .recent-work-caption p { font-size: .5rem; letter-spacing: .12em; }
    .recent-work-arrow { display: none; }
  }
</style>
