---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import Hero from '../components/Hero.astro';
import ProductList from '../components/ProductList.astro';
import Gallery from '../components/Gallery.astro';
import RecentWork from '../components/RecentWork.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import QuoteModal from '../components/QuoteModal';
import BackToTop from '../components/BackToTop';
---
<Layout title="Beautifully made. Entirely yours.">
 <Navbar client:load/><QuoteModal client:idle/><BackToTop client:idle/>
 <main id="main"><Hero/><ProductList/><Gallery/><RecentWork/><About/><Contact/></main>
 <footer class="site-footer shell"><a class="footer-brand" href="#hero">White Wolf<span>Furniture with feeling.</span></a><p>© {new Date().getFullYear()} White Wolf Furniture</p><a href="#hero">Back to the top ↑</a></footer>
</Layout>
