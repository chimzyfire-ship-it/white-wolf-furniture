---
import '../styles/global.css';
interface Props { title: string; }
const { title } = Astro.props;
---
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="Thoughtful furniture, crafted around you. Explore sofas, bed frames, kitchens, wardrobes and bespoke furniture from White Wolf Furniture in Sapele, Nigeria."/><meta name="theme-color" content="#f7f5f0"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><title>{title} | White Wolf Furniture</title></head><body><a class="skip-link" href="#main">Skip to content</a><slot/></body></html>
